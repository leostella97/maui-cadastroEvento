<?xml version="1.0" encoding="utf-8" ?>
<!-- página principal de cadastro do evento -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="cadastroEvento.MainPage"
             Title="cadastro de evento">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">

            <!-- título da tela -->
            <Label Text="Cadastro de Evento"
                   FontSize="24"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   Margin="0,0,0,10" />

            <!-- campo nome do evento -->
            <Label Text="Nome do evento:" />
            <Entry x:Name="entryNome"
                   Placeholder="Digite o nome do evento"
                   Text="{Binding Nome}" />

            <!-- data de início -->
            <Label Text="Data de início:" />
            <DatePicker x:Name="dateInicio"
                        Date="{Binding DataInicio}" />

            <!-- data de término -->
            <Label Text="Data de término:" />
            <DatePicker x:Name="dateTermino"
                        Date="{Binding DataTermino}" />

            <!-- número de participantes -->
            <Label Text="Número de participantes:" />
            <Entry x:Name="entryParticipantes"
                   Placeholder="Digite a quantidade"
                   Keyboard="Numeric"
                   Text="{Binding NumeroParticipantes}" />

            <!-- local do evento -->
            <Label Text="Local do evento:" />
            <Entry x:Name="entryLocal"
                   Placeholder="Digite o local"
                   Text="{Binding Local}" />

            <!-- custo por participante -->
            <Label Text="Custo por participante (R$):" />
            <Entry x:Name="entryCusto"
                   Placeholder="Digite o valor"
                   Keyboard="Numeric"
                   Text="{Binding CustoPorParticipante}" />

            <!-- botão para cadastrar e ver resumo -->
            <Button x:Name="btnCadastrar"
                    Text="Cadastrar Evento"
                    Clicked="BtnCadastrar_Clicked"
                    BackgroundColor="#512BD4"
                    TextColor="White"
                    FontAttributes="Bold"
                    Margin="0,15,0,0" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
